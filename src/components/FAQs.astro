---
import { faqs } from "../data/faqs";
---

<section id="faqs" aria-labelledby="faqs-title" class="pb-20 pt-14">
  <div class="mx-auto flex max-w-[860px] flex-col gap-4 px-5 md:px-8">
    <h2 id="faqs-title" class="m-0 text-[30px] font-black leading-tight md:text-[40px]">Preguntas frecuentes</h2>
    <div>
      {
        faqs.map((faq, index) => (
          <details class="group border-b border-slate-200 dark:border-zinc-800" open={index === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
              {faq.question}
              <svg class="size-[22px] shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </summary>
            <p class="m-0 pb-5 text-base leading-relaxed text-muted dark:text-zinc-400">{faq.answer}</p>
          </details>
        ))
      }
    </div>
    <button
      type="button"
      data-open-chat
      class="mt-4 inline-flex min-h-12 items-center gap-2 self-start rounded-control border border-slate-300 bg-white px-5 font-bold text-ink hover:border-brand-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50"
    >
      ¿Otra duda? Pregunta a Maingoo
    </button>
  </div>
</section>
