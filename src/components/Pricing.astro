---
const beta = [
  "Facturas y albaranes leídos por la IA",
  "Proveedores, costes y alertas de precio",
  "Inventario y recuento",
  "Recetas, escandallos y alérgenos",
  "TPV, comandero y pantalla de cocina",
  "APPCC y sensores de temperatura",
  "Chat y llamada con Maingoo AI",
  "Soporte directo del equipo",
];
const plans = [
  {
    name: "Profesional",
    text: "Para un local que lo quiere todo en Maingoo.",
    items: ["Todo lo de la beta", "Todas las funciones que lancemos", "Soporte prioritario"],
  },
  {
    name: "Empresarial",
    text: "Para grupos y operaciones grandes.",
    items: ["Varios locales", "Usuarios ilimitados", "Todo lo del plan Profesional"],
  },
];
const tick = "M4 12l5 5L20 6";
---

<section id="pricing" aria-labelledby="pricing-title" class="pb-14 pt-[72px]">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8 px-5 md:px-8">
    <div class="flex max-w-[720px] flex-col gap-3">
      <span class="text-[13px] font-black uppercase tracking-[0.08em] text-brand-700 dark:text-brand-300">Precios</span>
      <h2 id="pricing-title" class="m-0 text-[30px] font-black leading-tight md:text-[40px]">Únete a la beta de Maingoo.</h2>
      <p class="m-0 text-base leading-relaxed text-muted md:text-lg dark:text-zinc-400">
        Acceso anticipado gratuito para los restaurantes que quieren formar parte de nuestra (r)evolución.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      <article class="flex flex-col gap-4 rounded-card border-2 border-brand-500 bg-white p-7 dark:bg-zinc-900">
        <span class="inline-flex min-h-[30px] items-center self-start rounded-full border border-brand-200 bg-brand-50 px-3 text-[13px] font-bold text-brand-700 dark:border-brand-700 dark:bg-brand-950 dark:text-brand-300">
          Disponible ahora
        </span>
        <h3 class="m-0 text-[22px] font-bold">Beta</h3>
        <p class="m-0"><strong class="text-[44px] font-black">Gratis</strong> <span class="text-muted dark:text-zinc-400">durante la beta</span></p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px]">
          {
            beta.map((item) => (
              <li class="flex gap-2.5">
                <svg class="mt-0.5 size-4 shrink-0 text-brand-700 dark:text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d={tick}></path></svg>
                {item}
              </li>
            ))
          }
        </ul>
        <span class="flex-1"></span>
        <a
          href="/#contact"
          class="inline-flex min-h-12 items-center justify-center rounded-control bg-brand-600 font-bold text-white no-underline transition-colors hover:bg-brand-700 dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300"
        >
          Solicitar acceso a la beta
        </a>
        <span class="text-center text-[13px] text-muted dark:text-zinc-400">Sin permanencia</span>
      </article>

      {
        plans.map((plan) => (
          <article class="flex flex-col gap-4 rounded-card border border-slate-200 bg-white p-7 dark:border-zinc-800 dark:bg-zinc-900">
            <span class="inline-flex min-h-[30px] items-center self-start rounded-full border border-amber-300 bg-amber-50 px-3 text-[13px] font-bold text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">
              Próximamente
            </span>
            <h3 class="m-0 text-[22px] font-bold">{plan.name}</h3>
            <p class="m-0 text-[15px] text-muted dark:text-zinc-400">{plan.text}</p>
            <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px]">
              {plan.items.map((item) => (
                <li class="flex gap-2.5">
                  <svg class="mt-0.5 size-4 shrink-0 text-brand-700 dark:text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d={tick}></path></svg>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="m-0 rounded-card bg-brand-50 px-5 py-4 text-[15px] leading-relaxed text-brand-700 dark:bg-brand-950 dark:text-brand-300">
      Precio mensual fijo para siempre en los planes Profesional y Empresarial, con todas las funciones actuales y futuras.
    </p>
  </div>
</section>
