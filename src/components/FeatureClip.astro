---
import fs from "node:fs";
import path from "node:path";

export interface Props {
  /** File stem in public/videos (clip.mp4, clip.webm). */
  clip: string;
  poster?: string;
  alt: string;
  seconds?: number;
  /** SVG path drawn when there is no poster. */
  icon?: string;
  eager?: boolean;
}

const { clip, poster, alt, seconds, icon, eager = false } = Astro.props;
const videoDir = path.join(process.cwd(), "public", "videos");
const sources = ["webm", "mp4"].filter((ext) => fs.existsSync(path.join(videoDir, `${clip}.${ext}`)));
const hasVideo = sources.length > 0;
---

<div class="relative aspect-[16/10] overflow-hidden bg-deep">
  {
    hasVideo ? (
      <video
        class="size-full object-cover object-left-top"
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        aria-label={alt}
        data-feature-clip
      >
        {sources.map((ext) => (
          <source src={`/videos/${clip}.${ext}`} type={`video/${ext}`} />
        ))}
      </video>
    ) : poster ? (
      <img
        src={poster}
        alt={alt}
        class="size-full object-cover object-left-top"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      <div class="flex size-full items-center justify-center" role="img" aria-label={alt}>
        <span class="flex size-[72px] items-center justify-center rounded-[18px] bg-white/10 text-brand-200">
          <svg class="size-[38px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={icon}></path>
          </svg>
        </span>
      </div>
    )
  }
  {
    hasVideo && seconds && (
      <span class="pointer-events-none absolute bottom-3 left-3 inline-flex min-h-[30px] items-center gap-1.5 rounded-full bg-slate-900/70 px-2.5 text-xs font-bold text-white">
        <svg class="size-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 4l13 8-13 8z"></path>
        </svg>
        Vídeo · {seconds} s
      </span>
    )
  }
  {
    hasVideo && (
      <button
        type="button"
        class="group absolute inset-0 flex cursor-zoom-in items-start justify-end p-3 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-brand-400"
        aria-label={`Ampliar vídeo: ${alt}`}
        data-clip-open={clip}
        data-clip-sources={sources.join(",")}
        data-clip-alt={alt}>
        <span class="inline-flex size-9 items-center justify-center rounded-full bg-slate-900/70 text-white opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
          </svg>
        </span>
      </button>
    )
  }
</div>

<script>
  // Clips play muted while visible; with reduced motion they keep the poster.
  const clips = document.querySelectorAll<HTMLVideoElement>("video[data-feature-clip]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (clips.length && !reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) void video.play().catch(() => undefined);
          else video.pause();
        }
      },
      { threshold: 0.4 }
    );
    clips.forEach((video) => observer.observe(video));
  }

  // Click a clip to watch it large in a modal; Esc, the close button or the backdrop close it.
  const openers = document.querySelectorAll<HTMLButtonElement>("button[data-clip-open]");
  if (openers.length) {
    const dialog = document.createElement("dialog");
    dialog.className =
      "m-auto w-[min(1200px,94vw)] overflow-visible rounded-card bg-transparent p-0 backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm";
    dialog.innerHTML = `
      <div class="relative">
        <video class="block w-full rounded-card bg-deep shadow-2xl" controls autoplay muted loop playsinline></video>
        <button type="button" data-clip-close aria-label="Cerrar vídeo"
          class="absolute -top-12 right-0 inline-flex size-10 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>`;
    document.body.appendChild(dialog);
    const player = dialog.querySelector("video")!;
    const close = () => dialog.close();
    dialog.querySelector("[data-clip-close]")!.addEventListener("click", close);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
    dialog.addEventListener("close", () => {
      player.pause();
      player.removeAttribute("src");
      player.replaceChildren();
      player.load();
    });
    openers.forEach((button) =>
      button.addEventListener("click", () => {
        const clip = button.dataset.clipOpen!;
        player.replaceChildren(
          ...button.dataset.clipSources!.split(",").map((ext) => {
            const source = document.createElement("source");
            source.src = `/videos/${clip}.${ext}`;
            source.type = `video/${ext}`;
            return source;
          })
        );
        player.setAttribute("aria-label", button.dataset.clipAlt ?? "");
        player.load();
        dialog.showModal();
        void player.play().catch(() => undefined);
      })
    );
  }
</script>
