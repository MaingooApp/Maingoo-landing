---
import FeatureClip from "./FeatureClip.astro";

// Same business types as the contact form
const businesses = ["Restaurante", "Bar", "Cafetería", "Buffet", "Coctelería", "Catering", "Cervecería", "Foodtruck", "Chiringuito", "Heladería", "Panadería", "Pizzería", "Hamburguesería"];

const points = [
  "Ahorra horas de trabajo cada semana",
  "Diseñado junto a gerentes de hostelería reales",
  "Funciona en ordenador, tablet y móvil",
];
---

<section aria-labelledby="hero-title" class="pb-14 pt-12 md:pb-16 md:pt-[72px]">
  <div class="mx-auto grid max-w-[1200px] items-center gap-10 px-5 md:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:gap-14">
    <div class="flex flex-col gap-[22px]">
      <span
        class="inline-flex min-h-[30px] items-center self-start rounded-full border border-brand-200 bg-brand-50 px-3 text-[13px] font-bold text-brand-700 dark:border-brand-700 dark:bg-brand-950 dark:text-brand-300"
      >
        Beta abierta para hostelería
      </span>
      <h1 id="hero-title" class="m-0 text-[44px] font-black leading-[1.05] tracking-tight md:text-[64px]">
        <span class="sr-only">Gestiona tu negocio de hostelería con IA.</span>
        <span aria-hidden="true" class="block">Gestiona tu</span>
        <span aria-hidden="true" data-business-reel class="relative block h-[1.12em] overflow-hidden text-brand-600 dark:text-brand-300">
          {
            businesses.map((business, index) => (
              <span class:list={["business-word", index === 0 && "is-current"]}>{business}</span>
            ))
          }
        </span>
        <span aria-hidden="true" class="block">con IA.</span>
      </h1>
      <p class="m-0 text-[19px] font-bold text-brand-700 md:text-[22px] dark:text-brand-300">Gana tiempo. Maingoo hace el resto.</p>
      <p class="m-0 text-base leading-relaxed text-muted md:text-lg dark:text-zinc-400">
        Maingoo lee tus facturas y albaranes, cuadra el stock y los costes, lleva el TPV, la cocina y el APPCC, y te
        avisa de lo que importa.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/#contact"
          class="inline-flex min-h-14 items-center rounded-control bg-brand-600 px-5 text-[17px] font-bold text-white no-underline transition-colors hover:bg-brand-700 dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300"
        >
          Solicitar acceso a la beta
        </a>
        <button
          type="button"
          data-open-chat
          class="inline-flex min-h-14 items-center gap-2 rounded-control border border-slate-300 bg-white px-5 text-[17px] font-bold text-ink transition-colors hover:border-brand-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z"></path>
          </svg>
          Pregunta a Maingoo
        </button>
      </div>
      <ul class="m-0 mt-2 flex list-none flex-col gap-2.5 p-0 text-[15px] text-muted dark:text-zinc-400">
        {
          points.map((point) => (
            <li class="flex items-center gap-2.5">
              <span
                class="flex size-6 items-center justify-center rounded-full border border-teal-200 bg-teal-50 text-teal-700 dark:border-teal-900 dark:bg-teal-950 dark:text-teal-300"
                aria-hidden="true"
              >
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                  <path d="M4 12l5 5L20 6"></path>
                </svg>
              </span>
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <figure
        class="m-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_24px_60px_rgba(15,23,42,0.14)] dark:border-zinc-800 dark:bg-zinc-900"
      >
        <div class="flex gap-1.5 border-b border-slate-200 bg-slate-50 px-3.5 py-2.5 dark:border-zinc-800 dark:bg-zinc-800" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-slate-300 dark:bg-zinc-600"></span>
          <span class="size-2.5 rounded-full bg-slate-300 dark:bg-zinc-600"></span>
          <span class="size-2.5 rounded-full bg-slate-300 dark:bg-zinc-600"></span>
        </div>
        <FeatureClip
          clip="panel"
          poster="/posters/dashboard.jpg"
          alt="Panel de control de Maingoo con las ventas del día, la sala y el stock"
          seconds={10}
          eager
        />
      </figure>

      <div
        class="absolute -bottom-7 -left-9 hidden w-[300px] flex-col gap-2 rounded-card border border-slate-200 bg-white p-4 shadow-[0_16px_40px_rgba(15,23,42,0.16)] lg:flex dark:border-zinc-800 dark:bg-zinc-900"
      >
        <span
          class="inline-flex min-h-[30px] items-center self-start rounded-full border border-violet-200 bg-violet-50 px-3 text-[13px] font-bold text-violet-700 dark:border-violet-900 dark:bg-violet-950 dark:text-violet-300"
        >
          Maingoo AI
        </span>
        <strong class="text-[15px] leading-snug">El aceite de oliva 5 L ha subido un 12,4 % en Hnos. Ruiz.</strong>
        <span class="text-[13px] text-muted dark:text-zinc-400">Ya lo tienes en el coste de tus recetas.</span>
      </div>

      <div
        class="absolute -right-6 top-14 hidden items-center gap-2.5 rounded-card border border-slate-200 bg-white px-3.5 py-3 shadow-[0_16px_40px_rgba(15,23,42,0.16)] lg:flex dark:border-zinc-800 dark:bg-zinc-900"
      >
        <span class="flex size-9 items-center justify-center rounded-control bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M10 13.5V4a2 2 0 014 0v9.5a4 4 0 11-4 0z"></path>
          </svg>
        </span>
        <span class="flex flex-col leading-tight">
          <strong class="text-[15px]">Cámara de carne · 3,2 °C</strong>
          <span class="text-xs text-muted dark:text-zinc-400">En rango · hace 1 min</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .business-word {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(70%);
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 520ms;
  }
  .business-word.is-current {
    opacity: 1;
    transform: translateY(0);
  }
  .business-word.is-leaving {
    transform: translateY(-70%);
  }
</style>

<script>
  const reel = document.querySelector("[data-business-reel]");
  const words = reel ? [...reel.children] : [];
  // Without motion the first word ("Restaurante") stays
  if (words.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let current = 0;
    setInterval(() => {
      if (document.hidden) return;
      const next = (current + 1) % words.length;
      words.forEach((word) => word.classList.remove("is-leaving"));
      words[current].classList.replace("is-current", "is-leaving");
      words[next].classList.add("is-current");
      current = next;
    }, 2200);
  }
</script>
