---
import FeatureClip from "./FeatureClip.astro";
import { featureClips, featureGroups, type FeatureGroup } from "../data/features";

const filters: { id: FeatureGroup | "all"; name: string; count: number }[] = [
  { id: "all", name: "Todas", count: featureClips.length },
  ...(Object.keys(featureGroups) as FeatureGroup[]).map((id) => ({
    id,
    name: featureGroups[id],
    count: featureClips.filter((clip) => clip.group === id).length,
  })),
];
---

<section id="features" aria-labelledby="features-title" class="py-14">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-7 px-5 md:px-8">
    <div class="flex max-w-[760px] flex-col gap-3">
      <span class="text-[13px] font-black uppercase tracking-[0.08em] text-brand-700 dark:text-brand-300">Funciones</span>
      <h2 id="features-title" class="m-0 text-[30px] font-black leading-tight md:text-[40px]">
        Todo tu restaurante, en un solo sitio.
      </h2>
      <p class="m-0 text-base leading-relaxed text-muted md:text-lg dark:text-zinc-400">
        Cada función tiene su vídeo corto con la app real y datos de ejemplo.
      </p>
    </div>

    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar funciones">
      {
        filters.map((filter) => (
          <button
            type="button"
            data-feature-filter={filter.id}
            aria-pressed={filter.id === "all" ? "true" : "false"}
            class="min-h-11 rounded-full border border-slate-300 bg-white px-4 text-[15px] font-bold text-ink transition-colors hover:border-brand-500 aria-pressed:border-brand-600 aria-pressed:bg-brand-600 aria-pressed:text-white dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 dark:aria-pressed:border-brand-400 dark:aria-pressed:bg-brand-400 dark:aria-pressed:text-brand-950"
          >
            {filter.name} <span class="font-normal opacity-70">{filter.count}</span>
          </button>
        ))
      }
    </div>

    <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        featureClips.map((clip) => (
          <li data-feature-group={clip.group}>
            <article class="flex h-full flex-col overflow-hidden rounded-card border border-slate-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
              <FeatureClip clip={clip.clip} poster={clip.poster} alt={`Vídeo: ${clip.title}`} seconds={clip.seconds} icon={clip.icon} />
              <div class="flex flex-col gap-2 px-[18px] pb-[18px] pt-4">
                <span class="text-[11px] font-black uppercase tracking-[0.08em] text-brand-700 dark:text-brand-300">
                  {featureGroups[clip.group]}
                </span>
                <h3 class="m-0 text-lg font-bold leading-snug">{clip.title}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-muted dark:text-zinc-400">{clip.text}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-feature-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-feature-group]");
  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const group = button.dataset.featureFilter;
      filterButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      cards.forEach((card) => {
        card.hidden = group !== "all" && card.dataset.featureGroup !== group;
      });
    });
  });
</script>
