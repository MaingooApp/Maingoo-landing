---
const links = [
  { href: "/#features", label: "Funciones" },
  { href: "/#pricing", label: "Precios" },
  { href: "/#contact", label: "Contacto" },
  { href: "/#faqs", label: "Preguntas" },
];
---

<header
  class="fixed top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/95"
>
  <div class="mx-auto flex h-[72px] max-w-[1200px] items-center gap-6 px-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline dark:text-zinc-50">
      <span class="flex size-10 items-center justify-center rounded-control bg-brand-50">
        <img src="/maingoo_logo.svg" alt="" width="30" height="30" class="size-[30px] object-contain" />
      </span>
      <span class="text-xl font-bold">Maingoo</span>
    </a>

    <nav aria-label="Principal" class="ml-3 hidden items-center gap-5 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="px-1 py-2.5 text-[15px] font-bold text-ink no-underline transition-colors hover:text-brand-700 dark:text-zinc-50 dark:hover:text-brand-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <span class="flex-1"></span>

    <button
      id="theme-toggle"
      type="button"
      class="flex size-11 items-center justify-center rounded-full border border-slate-300 bg-white text-ink transition-colors hover:border-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50"
      aria-label="Cambiar entre modo claro y oscuro"
    >
      <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"></path>
      </svg>
      <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6L4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
      </svg>
    </button>

    <a
      href="https://app.maingoo.tech/"
      class="hidden min-h-12 items-center rounded-control border border-slate-300 bg-white px-5 font-bold text-ink no-underline transition-colors hover:border-brand-500 lg:inline-flex dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50"
    >
      Iniciar sesión
    </a>
    <a
      href="/#contact"
      class="hidden min-h-12 items-center rounded-control bg-brand-600 px-5 font-bold text-white no-underline transition-colors hover:bg-brand-700 lg:inline-flex dark:bg-brand-400 dark:text-brand-950 dark:hover:bg-brand-300"
    >
      Solicitar acceso a la beta
    </a>

    <button
      id="mobile-menu-button"
      type="button"
      class="flex size-11 items-center justify-center rounded-control border border-slate-300 text-ink lg:hidden dark:border-zinc-700 dark:text-zinc-50"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
    >
      <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Menú móvil"
    class="hidden border-t border-slate-200 bg-white px-5 pb-5 pt-2 lg:hidden dark:border-zinc-800 dark:bg-zinc-900"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="flex min-h-12 items-center text-base font-bold text-ink no-underline dark:text-zinc-50"
        >
          {link.label}
        </a>
      ))
    }
    <div class="mt-3 flex flex-col gap-2">
      <a
        href="https://app.maingoo.tech/"
        class="flex min-h-12 items-center justify-center rounded-control border border-slate-300 font-bold text-ink no-underline dark:border-zinc-700 dark:text-zinc-50"
      >
        Iniciar sesión
      </a>
      <a
        href="/#contact"
        class="flex min-h-12 items-center justify-center rounded-control bg-brand-600 font-bold text-white no-underline dark:bg-brand-400 dark:text-brand-950"
      >
        Solicitar acceso a la beta
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // The initial theme is set inline in Layout.astro to avoid a flash; this only toggles and remembers it.
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("darkMode", String(isDark));
      } catch {
        /* storage blocked: the choice lasts for this visit */
      }
    });

    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    if (mobileMenuButton && mobileMenu) {
      const setMenuOpen = (isOpen: boolean) => {
        mobileMenu.classList.toggle("hidden", !isOpen);
        mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
        mobileMenuButton.setAttribute(
          "aria-label",
          isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación"
        );

        const path = mobileMenuButton.querySelector("path");
        if (path) {
          path.setAttribute(
            "d",
            isOpen ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16"
          );
        }
      };

      mobileMenuButton.addEventListener("click", () => {
        setMenuOpen(mobileMenu.classList.contains("hidden"));
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        if (target && !mobileMenuButton.contains(target) && !mobileMenu.contains(target)) {
          setMenuOpen(false);
        }
      });
    }
  });
</script>
