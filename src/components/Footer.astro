---
const columns = [
  {
    title: "Producto",
    links: [
      { href: "/#features", label: "Funciones" },
      { href: "/#pricing", label: "Precios" },
      { href: "/#contact", label: "Acceso a la beta" },
    ],
  },
  {
    title: "Ayuda",
    links: [
      { href: "/#contact", label: "Contacto" },
      { href: "/#faqs", label: "Preguntas frecuentes" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/politica-privacidad", label: "Política de privacidad" },
      { href: "/terminos-servicio", label: "Términos del servicio" },
      { href: "/cookies", label: "Cookies" },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white pb-7 pt-12 dark:border-zinc-800 dark:bg-zinc-900">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8 px-5 md:px-8">
    <div class="flex flex-wrap justify-between gap-8">
      <div class="flex max-w-[340px] flex-col gap-3">
        <span class="flex items-center gap-2.5">
          <span class="flex size-10 items-center justify-center rounded-control bg-brand-50">
            <img src="/maingoo_logo.svg" alt="" width="30" height="30" class="size-[30px] object-contain" />
          </span>
          <strong class="text-xl">Maingoo</strong>
        </span>
        <span class="text-[15px] text-muted dark:text-zinc-400">Gana tiempo. Maingoo hace el resto.</span>
      </div>
      <nav aria-label="Pie de página" class="flex flex-wrap gap-12 text-[15px]">
        {
          columns.map((column) => (
            <div class="flex flex-col gap-2.5">
              <strong>{column.title}</strong>
              {column.links.map((link) => (
                <a href={link.href} class="text-ink no-underline hover:text-brand-700 dark:text-zinc-50 dark:hover:text-brand-300">
                  {link.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>
    <p class="m-0 border-t border-slate-200 pt-5 text-[13px] text-muted dark:border-zinc-800 dark:text-zinc-400">
      © {year} Maingoo
    </p>
  </div>
</footer>
